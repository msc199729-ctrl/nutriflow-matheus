// NutriFlow - Schema Prisma (multi-tenant por workspace)
// PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  nutricionista
  paciente
  admin_clinica
  admin_sistema

  @@map("perfil_usuario")
}

enum OrigemDado {
  busca_manual
  scanner_codigo_barras
  reconhecimento_ocr

  @@map("origem_dado")
}
