diff --git a/src/formularios/respostas.ts b/src/formularios/respostas.ts
new file mode 100644
index 0000000..2a39649
--- /dev/null
+++ b/src/formularios/respostas.ts
@@ -0,0 +1,109 @@
+import { BadRequestException } from '@nestjs/common';
+import { Prisma } from '@prisma/client';
+import type { PrismaService } from '../prisma/prisma.service';
+import { normalizarOpcoes, validarResposta } from './formulario-tipos';
+
+/**
+ * Gravação de respostas — um caminho só para o link público e para o
+ * `POST /envios/:id/respostas` autenticado.
+ *
+ * Antes o link público validava e a rota autenticada não: dava para gravar um
+ * envio "respondido" com pergunta obrigatória em branco passando por fora da
+ * tela. Duas portas para o mesmo dado clínico têm de aplicar a mesma regra.
+ */
+export async function salvarRespostas(
+  prisma: PrismaService,
+  idEnvio: number,
+  respostas: Array<{
+    idPergunta: number;
+    valorResposta?: string;
+    explicacao?: string;
+  }>,
+): Promise<{ ok: true; idEnvio: number; respondidoEm: Date; total: number }> {
+  const envio = await prisma.envioFormulario.findUnique({
+    where: { id: idEnvio },
+    include: { modelo: { include: { perguntas: true } } },
+  });
+  if (!envio) throw new BadRequestException('Envio não encontrado');
+
+  const perguntas = new Map(envio.modelo.perguntas.map((p) => [p.id, p]));
+  const validas: Array<{
+    idPergunta: number;
+    valorResposta: string;
+    explicacao: string | null;
+  }> = [];
+
+  const vistas = new Set<number>();
+  for (const r of respostas ?? []) {
+    const pergunta = perguntas.get(r.idPergunta);
+    if (!pergunta) {
+      throw new BadRequestException(
+        `A pergunta ${r.idPergunta} não pertence a este formulário`,
+      );
+    }
+    if (vistas.has(r.idPergunta)) {
+      throw new BadRequestException(
+        `A pergunta ${r.idPergunta} foi enviada mais de uma vez`,
+      );
+    }
+    vistas.add(r.idPergunta);
+
+    const validada = validarResposta(pergunta, r.valorResposta, r.explicacao);
+    if (validada) {
+      validas.push({
+        idPergunta: r.idPergunta,
+        valorResposta: validada.valor,
+        explicacao: validada.explicacao,
+      });
+    }
+  }
+
+  // Obrigatória não respondida: o servidor recusa. Antes só a tela checava e
+  // um envio em branco entrava como "respondido".
+  const faltando = envio.modelo.perguntas.filter(
+    (p) => p.obrigatoria && !validas.some((v) => v.idPergunta === p.id),
+  );
+  if (faltando.length > 0) {
+    throw new BadRequestException(
+      `Responda as perguntas obrigatórias: ${faltando
+        .map((p) => p.textoPergunta ?? `#${p.id}`)
+        .join('; ')}`,
+    );
+  }
+
+  const agora = new Date();
+  await prisma.$transaction([
+    prisma.resposta.deleteMany({ where: { idEnvio } }),
+    ...(validas.length > 0
+      ? [
+          prisma.resposta.createMany({
+            data: validas.map((v) => ({
+              idEnvio,
+              idPergunta: v.idPergunta,
+              valorResposta: v.valorResposta,
+              explicacao: v.explicacao,
+            })),
+          }),
+        ]
+      : []),
+    prisma.envioFormulario.update({
+      where: { id: idEnvio },
+      data: {
+        // Mantém a data da primeira resposta: reenvio não reescreve histórico.
+        respondidoEm: envio.respondidoEm ?? agora,
+        status: 'respondido',
+        // Resposta nova volta para a fila: o nutricionista precisa reler.
+        revisadoEm: null,
+      },
+    }),
+  ]);
+
+  return {
+    ok: true,
+    idEnvio,
+    respondidoEm: envio.respondidoEm ?? agora,
+    total: validas.length,
+  };
+}
+
+export { normalizarOpcoes };
--
