diff --git a/src/formularios/formulario-tipos.ts b/src/formularios/formulario-tipos.ts
new file mode 100644
index 0000000..7bd5c55
--- /dev/null
+++ b/src/formularios/formulario-tipos.ts
@@ -0,0 +1,264 @@
+import { BadRequestException } from '@nestjs/common';
+import { Prisma } from '@prisma/client';
+
+/**
+ * Contrato entre o que o construtor grava, o que a página pública desenha e o
+ * que o servidor aceita como resposta.
+ *
+ * Antes disto `tipoResposta` era string livre: um typo ("multipla escolha" com
+ * espaço) virava um tipo que nada reconhece e a pergunta não renderizava. Aqui
+ * a lista é fechada e a validação acontece no servidor, não na tela.
+ */
+export const TIPOS_RESPOSTA = [
+  'texto',
+  'numero',
+  'escala',
+  'multipla_escolha',
+  'sim_nao',
+] as const;
+
+export type TipoResposta = (typeof TIPOS_RESPOSTA)[number];
+
+export const TIPO_PADRAO: TipoResposta = 'texto';
+
+/** Escala fixa 1–10, que é o que as duas telas já desenham. */
+export const ESCALA_MIN = 1;
+export const ESCALA_MAX = 10;
+
+export const OPCOES_SIM_NAO = ['Sim', 'Não'] as const;
+
+/** Rótulos legíveis, para mensagem de erro e para o painel. */
+export const ROTULO_TIPO: Record<TipoResposta, string> = {
+  texto: 'Texto',
+  numero: 'Número',
+  escala: 'Escala 1 a 10',
+  multipla_escolha: 'Múltipla escolha',
+  sim_nao: 'Sim/Não',
+};
+
+export interface OpcaoPergunta {
+  rotulo: string;
+  /**
+   * A sacada que substitui lógica condicional (copiada do LiveClin): a
+   * alternativa ruim obriga o paciente a explicar. 80% do valor por 10% do
+   * custo — sem motor de ramificação.
+   */
+  exigeExplicacao: boolean;
+}
+
+export function ehTipoResposta(valor: unknown): valor is TipoResposta {
+  return (
+    typeof valor === 'string' &&
+    (TIPOS_RESPOSTA as readonly string[]).includes(valor)
+  );
+}
+
+/**
+ * Normaliza `opcoes_json` nas duas formas que existem no banco:
+ *  - `["Sim","Não"]` (modelos antigos e o construtor atual)
+ *  - `[{ "rotulo": "Nenhuma", "exigeExplicacao": true }]`
+ * Devolve `null` quando o campo não é um array válido — quem chama decide se
+ * isso é erro de gravação ou só "sem opções".
+ */
+export function normalizarOpcoes(raw: unknown): OpcaoPergunta[] | null {
+  if (raw == null) return null;
+  if (!Array.isArray(raw)) return null;
+  const saida: OpcaoPergunta[] = [];
+  for (const item of raw) {
+    if (typeof item === 'string') {
+      const rotulo = item.trim();
+      if (!rotulo) continue;
+      saida.push({ rotulo, exigeExplicacao: false });
+      continue;
+    }
+    if (item && typeof item === 'object') {
+      const obj = item as { rotulo?: unknown; exigeExplicacao?: unknown };
+      if (typeof obj.rotulo !== 'string') return null;
+      const rotulo = obj.rotulo.trim();
+      if (!rotulo) continue;
+      saida.push({
+        rotulo,
+        exigeExplicacao: obj.exigeExplicacao === true,
+      });
+      continue;
+    }
+    return null;
+  }
+  return saida.length > 0 ? saida : null;
+}
+
+/**
+ * Só grava a forma "objeto" quando alguma alternativa exige explicação; caso
+ * contrário mantém `string[]`, que é o que os modelos antigos têm e o que a
+ * lista simples consegue ler.
+ */
+export function opcoesParaJson(
+  opcoes: OpcaoPergunta[] | null,
+): Prisma.InputJsonValue | typeof Prisma.DbNull {
+  if (opcoes == null || opcoes.length === 0) return Prisma.DbNull;
+  const algumaExplicacao = opcoes.some((o) => o.exigeExplicacao);
+  if (!algumaExplicacao) {
+    return opcoes.map((o) => o.rotulo);
+  }
+  return opcoes.map((o) => ({
+    rotulo: o.rotulo,
+    exigeExplicacao: o.exigeExplicacao,
+  }));
+}
+
+export interface PerguntaValidada {
+  tipoResposta: TipoResposta;
+  opcoes: OpcaoPergunta[] | null;
+  opcoesJson: Prisma.InputJsonValue | typeof Prisma.DbNull;
+}
+
+/**
+ * Regras de gravação de pergunta. Falha aqui é 400 imediato: melhor recusar a
+ * pergunta do que guardar uma que o paciente não consegue responder.
+ */
+export function validarPergunta(input: {
+  tipoResposta?: unknown;
+  opcoes?: unknown;
+}): PerguntaValidada {
+  const bruto = input.tipoResposta ?? TIPO_PADRAO;
+  if (!ehTipoResposta(bruto)) {
+    throw new BadRequestException(
+      `Tipo de resposta inválido. Use um destes: ${TIPOS_RESPOSTA.join(', ')}.`,
+    );
+  }
+
+  const informadas = input.opcoes == null ? null : normalizarOpcoes(input.opcoes);
+  if (input.opcoes != null && informadas == null) {
+    throw new BadRequestException(
+      'Opções inválidas: envie uma lista de textos ou de objetos { rotulo, exigeExplicacao }.',
+    );
+  }
+
+  if (bruto === 'multipla_escolha') {
+    if (informadas == null || informadas.length < 2) {
+      throw new BadRequestException(
+        'Múltipla escolha precisa de pelo menos duas opções.',
+      );
+    }
+    const rotulos = informadas.map((o) => o.rotulo.toLowerCase());
+    if (new Set(rotulos).size !== rotulos.length) {
+      throw new BadRequestException('Há opções repetidas nesta pergunta.');
+    }
+    return {
+      tipoResposta: bruto,
+      opcoes: informadas,
+      opcoesJson: opcoesParaJson(informadas),
+    };
+  }
+
+  // Sim/Não não precisa de opções gravadas: as duas são fixas e conhecidas.
+  if (bruto === 'sim_nao') {
+    return { tipoResposta: bruto, opcoes: null, opcoesJson: Prisma.DbNull };
+  }
+
+  // Texto, número e escala não têm alternativas. Gravar opções aqui só
+  // confundiria quem for ler depois.
+  return { tipoResposta: bruto, opcoes: null, opcoesJson: Prisma.DbNull };
+}
+
+export interface RespostaValidada {
+  valor: string;
+  explicacao: string | null;
+}
+
+interface PerguntaParaValidar {
+  id: number;
+  textoPergunta: string | null;
+  tipoResposta: string | null;
+  opcoesJson: Prisma.JsonValue | null;
+  obrigatoria: boolean;
+}
+
+/**
+ * Valida o valor de UMA pergunta e devolve o que deve ser gravado.
+ *
+ * Usada tanto pelo link público quanto pelo `POST /envios/:id/respostas`
+ * autenticado — antes só a tela checava obrigatória, então dava para gravar envio
+ * "respondido" em branco por fora da tela.
+ */
+export function validarResposta(
+  pergunta: PerguntaParaValidar,
+  valorBruto: unknown,
+  explicacaoBruta: unknown,
+): RespostaValidada | null {
+  const rotulo = pergunta.textoPergunta ?? `#${pergunta.id}`;
+  const valor = typeof valorBruto === 'string' ? valorBruto.trim() : '';
+  const explicacao =
+    typeof explicacaoBruta === 'string' ? explicacaoBruta.trim() : '';
+
+  if (valor === '') {
+    if (pergunta.obrigatoria) {
+      throw new BadRequestException(`Responda a pergunta obrigatória: ${rotulo}`);
+    }
+    return null;
+  }
+
+  const tipo = ehTipoResposta(pergunta.tipoResposta)
+    ? pergunta.tipoResposta
+    : TIPO_PADRAO;
+  let opcoes: OpcaoPergunta[] | null = null;
+
+  switch (tipo) {
+    case 'numero': {
+      const n = Number(valor.replace(',', '.'));
+      if (!Number.isFinite(n)) {
+        throw new BadRequestException(`"${rotulo}" precisa ser um número.`);
+      }
+      if (n < 0) {
+        throw new BadRequestException(`"${rotulo}" não pode ser negativo.`);
+      }
+      return { valor: String(n), explicacao: null };
+    }
+
+    case 'escala': {
+      const n = Number.parseInt(valor, 10);
+      if (!Number.isFinite(n) || n < ESCALA_MIN || n > ESCALA_MAX) {
+        throw new BadRequestException(
+          `"${rotulo}" deve ser um número de ${ESCALA_MIN} a ${ESCALA_MAX}.`,
+        );
+      }
+      return { valor: String(n), explicacao: null };
+    }
+
+    case 'sim_nao': {
+      if (valor !== 'Sim' && valor !== 'Não') {
+        throw new BadRequestException(`"${rotulo}" aceita apenas Sim ou Não.`);
+      }
+      return { valor, explicacao: null };
+    }
+
+    case 'multipla_escolha': {
+      opcoes = normalizarOpcoes(pergunta.opcoesJson);
+      if (opcoes == null || opcoes.length === 0) {
+        throw new BadRequestException(
+          `"${rotulo}" está sem opções configuradas. Avisa o nutricionista.`,
+        );
+      }
+      const escolhida = opcoes.find((o) => o.rotulo === valor);
+      if (!escolhida) {
+        throw new BadRequestException(
+          `"${rotulo}": a resposta "${valor}" não está entre as opções.`,
+        );
+      }
+      if (escolhida.exigeExplicacao && explicacao === '') {
+        throw new BadRequestException(
+          `Explique sua resposta em "${rotulo}": a alternativa escolhida pede um comentário.`,
+        );
+      }
+      return {
+        valor,
+        explicacao: escolhida.exigeExplicacao ? explicacao : null,
+      };
+    }
+
+    default:
+      // Texto livre: limite alto o bastante para um relato, baixo o bastante
+      // para não virar despejo de arquivo no banco.
+      return { valor: valor.slice(0, 4000), explicacao: null };
+  }
+}
