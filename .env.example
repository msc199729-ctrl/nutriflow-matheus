# Database (PostgreSQL) - use DATABASE_URL ou as variáveis separadas (DB_*)
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_banco?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=central_nutricional

# Seed: super administrador (obrigatório ao rodar `npm run prisma:seed`)
# SEED_ADMIN_EMAIL=seu-email@dominio.com
# SEED_ADMIN_SENHA=senha-forte-unica

# JWT
JWT_SECRET=altere-em-producao-use-uma-chave-longa-e-segura
JWT_EXPIRES_IN=7d

# OpenAI (para etapa de IA)
# OPENAI_API_KEY=

# App
PORT=3000
# Origens permitidas para CORS (separadas por vírgula; vazio = nenhuma)
# CORS_ORIGIN=http://localhost:3000,https://app.nutriflow.com.br

# E-mail (notificações transacionais — ex.: aprovação de nutricionista)
# Sem SMTP_HOST e MAIL_FROM, o envio é ignorado (log em nível debug).
# MAIL_APP_URL=https://app.seudominio.com/auth/login
# MAIL_APP_BASE_URL=https://app.seudominio.com
# MAIL_APP_NAME=ONutri
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ONutri <noreply@seudominio.com>
